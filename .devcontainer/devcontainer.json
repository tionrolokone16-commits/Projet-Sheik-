{
  "name": "Kira's FAT (Flutter)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  // Installation de Flutter (version fixée) : voir installer-flutter.sh.
  "postCreateCommand": "bash .devcontainer/installer-flutter.sh",

  // Flutter accessible partout : terminaux, tâches, extension Dart.
  "remoteEnv": {
    "PATH": "/home/vscode/flutter/bin:${containerEnv:PATH}"
  },

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Kira's FAT",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": {
        "dart.flutterSdkPath": "/home/vscode/flutter"
      }
    }
  }
}
